<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules><rule name="SEO segment 0" stopProcessing="true"><match url="^segmentos/ind-strias-em-geral/?$" /><action type="Redirect" url="/segmentos/industrias-em-geral/" redirectType="Permanent" /></rule><rule name="SEO segment 1" stopProcessing="true"><match url="^segmentos/ind-strias-qu-micas-petroqu-micas-e-leo-g-s/?$" /><action type="Redirect" url="/segmentos/industrias-quimicas-petroquimicas-e-oleo-gas/" redirectType="Permanent" /></rule><rule name="SEO segment 2" stopProcessing="true"><match url="^segmentos/alimentos-bebidas-higiene-e-farmac-uticas/?$" /><action type="Redirect" url="/segmentos/alimentos-bebidas-higiene-e-farmaceuticas/" redirectType="Permanent" /></rule><rule name="SEO segment 3" stopProcessing="true"><match url="^segmentos/minera-o-siderurgia-e-metalurgia/?$" /><action type="Redirect" url="/segmentos/mineracao-siderurgia-e-metalurgia/" redirectType="Permanent" /></rule><rule name="SEO segment 4" stopProcessing="true"><match url="^segmentos/log-stica-transportes-e-armazenagem/?$" /><action type="Redirect" url="/segmentos/logistica-transportes-e-armazenagem/" redirectType="Permanent" /></rule><rule name="SEO segment 5" stopProcessing="true"><match url="^segmentos/constru-o-civil-e-infraestrutura/?$" /><action type="Redirect" url="/segmentos/construcao-civil-e-infraestrutura/" redirectType="Permanent" /></rule><rule name="SEO segment 6" stopProcessing="true"><match url="^segmentos/agroneg-cio/?$" /><action type="Redirect" url="/segmentos/agronegocio/" redirectType="Permanent" /></rule><rule name="SEO segment 7" stopProcessing="true"><match url="^segmentos/com-rcio-condom-nios-e-servi-os/?$" /><action type="Redirect" url="/segmentos/comercio-condominios-e-servicos/" redirectType="Permanent" /></rule>
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
