<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# ── Static Asset Caching & Compression (Apache / Hostinger) ──
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: no cache / immediate revalidation
  ExpiresByType text/html "access plus 0 seconds"

  # Fixed-name static images and fonts: short cache (7 days) with revalidation
  ExpiresByType font/woff2 "access plus 7 days"
  ExpiresByType font/woff "access plus 7 days"
  ExpiresByType application/font-woff2 "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  # 1. HTML: prevent browser caching HTML to allow instant site updates
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # 2. Unversioned static assets (fixed names: webp, png, jpg, woff2, etc.): 7-day cache with revalidation
  <FilesMatch "\.(woff2|woff|webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>

  # 3. Hash-versioned assets in /assets/ (Vite output): 1-year immutable cache
  <IfModule mod_rewrite.c>
    SetEnvIf Request_URI "^/assets/" IS_HASHED_ASSET
    Header set Cache-Control "max-age=31536000, public, immutable" env=IS_HASHED_ASSET
  </IfModule>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/x-javascript text/javascript application/json image/svg+xml
</IfModule>
